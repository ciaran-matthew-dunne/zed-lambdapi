# --- terminal styling -------------------------------------------------

def _want_color():
    return sys.stdout.isatty() and not os.environ.get("NO_COLOR")

if _want_color():
    BOLD, DIM, RESET = "\033[1m", "\033[2m", "\033[0m"
    CYAN, GREEN, YELLOW, RED, MAGENTA = (
        "\033[36m", "\033[32m", "\033[33m", "\033[31m", "\033[35m")
else:
    BOLD = DIM = RESET = CYAN = GREEN = YELLOW = RED = MAGENTA = ""


def term_width():
    return shutil.get_terminal_size((80, 24)).columns


def rule(char="─"):
    return f"{DIM}{char * min(term_width(), 60)}{RESET}"


# --- paths and environment --------------------------------------------

def runtime_dir():
    """Private per-user directory for the panel and bridge sockets.

    A `lp-goals-<uid>` subdirectory (mode 0700) of $XDG_RUNTIME_DIR,
    or of the system temp dir when that is unset. Returns None when
    the directory cannot be created or is not a directory we own
    (e.g. squatted in a shared /tmp); callers fail open."""
    base = os.environ.get("XDG_RUNTIME_DIR")
    if not (base and os.path.isdir(base)):
        base = tempfile.gettempdir()
    d = os.path.join(base, f"lp-goals-{os.getuid()}")
    try:
        os.makedirs(d, mode=0o700, exist_ok=True)
        st = os.lstat(d)
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
            return None
        if stat.S_IMODE(st.st_mode) != 0o700:
            os.chmod(d, 0o700)
    except OSError:
        return None
    return d


def panel_socket_path():
    if os.environ.get("LP_GOALS_SOCKET"):
        return os.environ["LP_GOALS_SOCKET"]
    d = runtime_dir()
    return os.path.join(d, "panel.sock") if d else None


def bridge_socket_path(root_uri):
    """Socket path for this bridge instance. The name embeds both the
    workspace root (for discovery filtering) and the pid (so two Zed
    windows on the same project never collide). None = fail open."""
    if os.environ.get("LP_BRIDGE_SOCKET"):
        return os.environ["LP_BRIDGE_SOCKET"]
    d = runtime_dir()
    if d is None:
        return None
    digest = hashlib.sha1(root_uri.encode()).hexdigest()[:10]
    return os.path.join(d, f"lp-bridge-{digest}-{os.getpid()}.sock")


def bridge_socket_candidates():
    override = os.environ.get("LP_BRIDGE_SOCKET")
    if override:
        return [override] if os.path.exists(override) else []
    d = runtime_dir()
    if d is None:
        return []

    def mtime(p):
        try:
            return os.path.getmtime(p)
        except OSError:
            return 0.0

    pattern = os.path.join(d, "lp-bridge-*.sock")
    return sorted(glob.glob(pattern), key=mtime, reverse=True)


def find_lambdapi_cmd():
    """Build the `lambdapi lsp` command, mirroring the Zed extension."""
    binary = os.environ.get("LAMBDAPI_PATH") or shutil.which("lambdapi")
    if not binary:
        sys.exit("lp-goals: lambdapi not found. "
                 "Install with `opam install lambdapi` or set LAMBDAPI_PATH.")
    cmd = [binary, "lsp"]
    prefix = (os.environ.get("LAMBDAPI_LIB_ROOT")
              or os.environ.get("OPAM_SWITCH_PREFIX"))
    if prefix:
        cmd.append(f"--lib-root={prefix}/lib/lambdapi/lib_root")
    map_dirs = os.environ.get("LAMBDAPI_MAP_DIRS", "")
    for entry in map_dirs.split(","):
        entry = entry.strip()
        if entry:
            cmd.append(f"--map-dir={entry}")
    return cmd


def file_uri(path):
    return "file://" + urllib.parse.quote(os.path.abspath(path), safe="/")


def uri_to_path(uri):
    if uri.startswith("file://"):
        return urllib.parse.unquote(uri[len("file://"):])
    return uri


def ensure_on_path():
    """Expose this script as ~/.local/bin/lp-goals.

    The Zed extension embeds lp-goals and materializes it into its
    work directory, so users never install it by hand; the bridge
    (the first mode to run, when Zed starts the language server)
    symlinks itself onto PATH so the `lp-goals serve` / `lp-goals at`
    tasks can find it. Conservative by design:
    - LAMBDAPI_NO_INSTALL set: do nothing.
    - ~/.local/bin must already exist; we never create directories
      in $HOME.
    - A regular file (manual install) is left alone.
    - Only symlinks that provably point into a Zed extension work
      dir (an "extensions/work" path segment) are retargeted when
      the extension updates; foreign symlinks — even dangling ones —
      are never touched.
    Failures are swallowed: PATH setup must never break the LSP.
    """
    if os.name != "posix" or os.environ.get("LAMBDAPI_NO_INSTALL"):
        return
    try:
        target = os.path.realpath(os.path.abspath(__file__))
        bindir = os.path.expanduser("~/.local/bin")
        if not os.path.isdir(bindir):
            return
        link = os.path.join(bindir, "lp-goals")
        if os.path.islink(link):
            if os.path.realpath(link) == target:
                return
            parts = os.readlink(link).lower().split(os.sep)
            ours = any(a == "extensions" and b == "work"
                       for a, b in zip(parts, parts[1:]))
            if ours:
                os.unlink(link)
                os.symlink(target, link)
            return
        if os.path.exists(link):
            return
        os.symlink(target, link)
    except OSError:
        pass


def find_root(path):
    """Walk up from the file looking for lambdapi.pkg; that directory
    (or the file's own directory) becomes the LSP rootUri."""
    path = os.path.abspath(path)
    d = path if os.path.isdir(path) else os.path.dirname(path)
    cur = d
    while True:
        if os.path.isfile(os.path.join(cur, "lambdapi.pkg")):
            return cur
        parent = os.path.dirname(cur)
        if parent == cur:
            return d
        cur = parent


# --- LSP wire format ---------------------------------------------------

class MsgBuffer:
    """Incremental Content-Length framed JSON-RPC parser."""

    def __init__(self):
        self.buf = b""

    def feed(self, data):
        self.buf += data

    def messages(self):
        while True:
            msg = self._parse_one()
            if msg is None:
                return
            yield msg

    def _parse_one(self):
        while True:
            sep = self.buf.find(b"\r\n\r\n")
            if sep < 0:
                return None
            length = None
            for line in self.buf[:sep].split(b"\r\n"):
                key, _, val = line.partition(b":")
                if key.strip().lower() == b"content-length":
                    try:
                        length = int(val.strip())
                    except ValueError:
                        length = None
            if length is None or length < 0:
                # Malformed header: drop it and keep scanning so
                # messages queued behind it are not delayed.
                self.buf = self.buf[sep + 4:]
                continue
            start = sep + 4
            if len(self.buf) < start + length:
                return None
            body = self.buf[start:start + length]
            self.buf = self.buf[start + length:]
            try:
                # json.loads accepts bytes; ValueError also covers
                # UnicodeDecodeError from invalid UTF-8 bodies, so a
                # bad frame is consumed instead of killing the caller.
                return json.loads(body)
            except ValueError:
                continue


def lsp_frame(msg):
    body = json.dumps(msg, ensure_ascii=False).encode()
    return f"Content-Length: {len(body)}\r\n\r\n".encode() + body


def edit_end_position(old, new):
    """Infer the caret position from a full-text change: the end of
    the replaced region in the new text (right after what was typed;
    at the deletion point for deletions). Returns an LSP-style
    {line, character} dict, or None when the texts are equal."""
    if old == new:
        return None
    limit = min(len(old), len(new))
    p = 0
    while p < limit and old[p] == new[p]:
        p += 1
    s = 0
    while s < limit - p and old[len(old) - 1 - s] == new[len(new) - 1 - s]:
        s += 1
    end = len(new) - s
    line = new.count("\n", 0, end)
    col = end - (new.rfind("\n", 0, end) + 1)
    return {"line": line, "character": col}


# --- bridge (LSP proxy) -------------------------------------------------

# Requests panel clients are allowed to inject into the shared server.
INJECTABLE = {"proof/goals"}
INJECT_BASE = 1 << 30


class Bridge:
    """Transparent LSP stdio proxy with a Unix-socket side channel.

    Forwards Zed <-> server traffic unmodified (re-framed), while:
    - broadcasting publishDiagnostics and document open/change/close
      events to socket clients,
    - injecting whitelisted client requests into the server, with ids
      remapped so they never collide with Zed's, and routing the
      responses back to the owning client (never to Zed).

    The socket layer is fail-open: any error there is swallowed so the
    editor's LSP session is never disturbed.
    """

    def __init__(self, server_cmd):
        self.server_cmd = server_cmd
        self.proc = None
        self.zed_buf = MsgBuffer()
        self.srv_buf = MsgBuffer()
        self.listener = None
        self.sock_path = None
        self.clients = []          # connected panel sockets
        self.client_bufs = {}      # sock -> pending line buffer
        self.root_uri = None
        self.docs = {}             # uri -> version (open in Zed)
        self.texts = {}            # uri -> buffer text (for edit diffs)
        self.diags = {}            # uri -> last publishDiagnostics params
        self.inject_id = INJECT_BASE
        self.injected = {}         # bridged id -> (client sock, original id)
        self.srv_pending = bytearray()   # queued writes to the server

    # -- socket side channel (fail-open) ---------------------------

    def open_listener(self):
        """Bind the side-channel socket. The path is unique to this
        process (pid suffix), so an existing file is never unlinked —
        stale sockets are garbage-collected by panel discovery. Any
        failure just leaves the bridge without a listener."""
        self.listener = None
        path = bridge_socket_path(self.root_uri)
        if path is None:
            return
        try:
            listener = socket.socket(socket.AF_UNIX)
            listener.bind(path)
            os.chmod(path, 0o600)
            listener.listen(8)
        except OSError:
            return
        self.sock_path = path
        self.listener = listener

    def hello(self):
        return {"type": "hello", "root": self.root_uri,
                "docs": self.docs, "diags": self.diags}

    def send_client(self, sock, obj):
        try:
            sock.sendall(json.dumps(obj).encode() + b"\n")
        except OSError:
            self.drop_client(sock)

    def broadcast(self, obj):
        for sock in list(self.clients):
            self.send_client(sock, obj)

    def drop_client(self, sock):
        if sock in self.clients:
            self.clients.remove(sock)
        self.client_bufs.pop(sock, None)
        self.injected = {k: v for k, v in self.injected.items()
                         if v[0] is not sock}
        try:
            sock.close()
        except OSError:
            pass

    def handle_client_line(self, sock, line):
        try:
            req = json.loads(line)
        except ValueError:
            return
        method = req.get("method")
        if method not in INJECTABLE:
            self.send_client(sock, {
                "type": "response", "id": req.get("id"),
                "error": {"message": f"method not allowed: {method}"}})
            return
        self.inject_id += 1
        self.injected[self.inject_id] = (sock, req.get("id"))
        self.to_server({"jsonrpc": "2.0", "id": self.inject_id,
                        "method": method, "params": req.get("params", {})})

    # -- message peeking --------------------------------------------

    def peek_from_zed(self, msg):
        method = msg.get("method")
        if method == "initialize":
            self.root_uri = (msg.get("params", {}).get("rootUri")
                             or file_uri(os.getcwd()))
            self.open_listener()
        elif method in ("textDocument/didOpen", "textDocument/didChange"):
            params = msg.get("params", {})
            td = params.get("textDocument", {})
            uri = td.get("uri")
            if uri:
                self.docs[uri] = td.get("version", 0)
                # Zed uses full-text sync; diff consecutive versions to
                # locate the caret so the panel can follow it.
                pos = None
                if method == "textDocument/didOpen":
                    self.texts[uri] = td.get("text", "")
                else:
                    changes = params.get("contentChanges", [])
                    if changes and "text" in changes[-1] \
                            and "range" not in changes[-1]:
                        new = changes[-1]["text"]
                        pos = edit_end_position(
                            self.texts.get(uri, ""), new)
                        self.texts[uri] = new
                event = {"type": "doc", "method": method,
                         "uri": uri, "version": self.docs[uri]}
                if pos:
                    event["pos"] = pos
                self.broadcast(event)
        elif method == "textDocument/didClose":
            uri = msg.get("params", {}).get("textDocument", {}).get("uri")
            if uri:
                self.docs.pop(uri, None)
                self.texts.pop(uri, None)
                self.diags.pop(uri, None)
                self.broadcast({"type": "doc", "method": method,
                                "uri": uri, "version": None})

    def peek_from_server(self, msg):
        """Returns False if the message must NOT be forwarded to Zed."""
        mid = msg.get("id")
        if mid in self.injected:
            sock, orig = self.injected.pop(mid)
            reply = {"type": "response", "id": orig}
            if "result" in msg:
                reply["result"] = msg["result"]
            else:
                reply["error"] = msg.get("error",
                                         {"message": "request failed"})
            self.send_client(sock, reply)
            return False
        if msg.get("method") == "textDocument/publishDiagnostics":
            params = msg.get("params", {})
            uri = params.get("uri")
            if uri:
                self.diags[uri] = params
            self.broadcast({"type": "notif",
                            "method": "textDocument/publishDiagnostics",
                            "params": params})
        return True

    # -- plumbing ----------------------------------------------------

    def to_server(self, msg):
        self.srv_pending += lsp_frame(msg)
        self.flush_server()

    def flush_server(self):
        """Write queued bytes to the server's stdin without blocking;
        whatever does not fit goes out when select() reports the pipe
        writable, so a stalled server can never wedge the proxy."""
        while self.srv_pending:
            try:
                n = os.write(self.proc.stdin.fileno(), self.srv_pending)
            except (BlockingIOError, InterruptedError):
                return
            except OSError:
                self.srv_pending.clear()   # server gone; drop the queue
                return
            del self.srv_pending[:n]

    def to_zed(self, msg):
        sys.stdout.buffer.write(lsp_frame(msg))
        sys.stdout.buffer.flush()

    def cleanup(self):
        if self.sock_path:
            try:
                os.unlink(self.sock_path)
            except OSError:
                pass
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()

    def run(self):
        ensure_on_path()
        self.proc = subprocess.Popen(
            self.server_cmd, stdin=subprocess.PIPE,
            stdout=subprocess.PIPE)
        zed_in = sys.stdin.buffer
        os.set_blocking(zed_in.fileno(), False)
        os.set_blocking(self.proc.stdout.fileno(), False)
        os.set_blocking(self.proc.stdin.fileno(), False)
        try:
            while True:
                fds = [zed_in, self.proc.stdout]
                if self.listener:
                    fds.append(self.listener)
                fds.extend(self.clients)
                wfds = [self.proc.stdin] if self.srv_pending else []
                ready, writable, _ = select.select(fds, wfds, [], 1.0)

                if writable:
                    self.flush_server()

                if zed_in in ready:
                    data = zed_in.read()
                    if data == b"":       # Zed hung up
                        return
                    if data:
                        self.zed_buf.feed(data)
                        for msg in self.zed_buf.messages():
                            try:
                                self.peek_from_zed(msg)
                            except Exception:
                                pass
                            self.to_server(msg)

                if self.proc.stdout in ready:
                    data = self.proc.stdout.read()
                    if data == b"":       # server died; Zed restarts us
                        return
                    if data:
                        self.srv_buf.feed(data)
                        for msg in self.srv_buf.messages():
                            forward = True
                            try:
                                forward = self.peek_from_server(msg)
                            except Exception:
                                pass
                            if forward:
                                self.to_zed(msg)

                if self.listener and self.listener in ready:
                    try:
                        conn, _ = self.listener.accept()
                        conn.setblocking(False)
                        self.clients.append(conn)
                        self.client_bufs[conn] = b""
                        self.send_client(conn, self.hello())
                    except OSError:
                        pass

                for sock in [s for s in self.clients if s in ready]:
                    try:
                        data = sock.recv(65536)
                    except OSError:
                        data = b""
                    if not data:
                        self.drop_client(sock)
                        continue
                    self.client_bufs[sock] += data
                    while b"\n" in self.client_bufs[sock]:
                        line, _, rest = self.client_bufs[sock].partition(b"\n")
                        self.client_bufs[sock] = rest
                        try:
                            self.handle_client_line(sock, line)
                        except Exception:
                            pass
        finally:
            self.cleanup()


# --- backends for the panel ---------------------------------------------
#
# Both backends deliver normalized events:
#   ("diags", uri, diagnostics)   check finished, diagnostics published
#   ("changed", uri, pos)         document changed (pos: inferred caret
#                                 as LSP {line, character}, or None)
#   ("response", id, result)      answer to a goals request
#   ("closed", uri)               document closed
#   ("down", reason)              backend lost


class BridgeBackend:
    """Panel backend attached to a running `lp-goals bridge`."""

    def __init__(self, sock, hello):
        self.sock = sock
        self.buf = b""
        self.root = hello.get("root")
        self.docs = dict(hello.get("docs", {}))
        self.initial_diags = hello.get("diags", {})
        self.next_id = 0

    @classmethod
    def connect(cls, path, want_path=None):
        """Attach to the bridge at [path]; returns None if unusable or
        if its workspace root does not contain [want_path]. Sockets
        whose bridge is provably dead are unlinked (self-cleaning)."""
        sock = socket.socket(socket.AF_UNIX)
        sock.settimeout(2.0)
        try:
            sock.connect(path)
        except OSError as e:
            sock.close()
            if isinstance(e, ConnectionRefusedError):
                try:
                    os.unlink(path)   # dead bridge left its socket behind
                except OSError:
                    pass
            return None
        try:
            buf = b""
            while b"\n" not in buf:
                data = sock.recv(65536)
                if not data:
                    raise OSError("bridge closed")
                buf += data
            hello = json.loads(buf.split(b"\n", 1)[0])
            if hello.get("type") != "hello":
                raise OSError("bad hello")
        except (OSError, ValueError):
            try:
                sock.close()
            except OSError:
                pass
            return None
        sock.settimeout(None)
        sock.setblocking(False)
        backend = cls(sock, hello)
        backend.buf = buf.split(b"\n", 1)[1]
        if want_path and backend.root:
            root_path = uri_to_path(backend.root)
            if not os.path.abspath(want_path).startswith(
                    root_path.rstrip("/") + "/"):
                backend.close()
                return None
        return backend

    @classmethod
    def discover(cls, want_path=None):
        for path in bridge_socket_candidates():
            backend = cls.connect(path, want_path)
            if backend:
                return backend
        return None

    def fds(self):
        return [self.sock]

    def close(self):
        try:
            self.sock.close()
        except OSError:
            pass

    def is_open(self, uri):
        return uri in self.docs

    def request_goals(self, uri, line0, col0):
        self.next_id += 1
        msg = {"id": self.next_id, "method": "proof/goals",
               "params": {"textDocument": {"uri": uri},
                          "position": {"line": line0, "character": col0}}}
        try:
            self.sock.sendall(json.dumps(msg).encode() + b"\n")
        except OSError:
            pass
        return self.next_id

    def drain(self):
        try:
            data = self.sock.recv(1 << 20)
        except (BlockingIOError, InterruptedError):
            return
        except OSError:
            yield ("down", "bridge connection lost")
            return
        if not data:
            yield ("down", "bridge closed (LSP restarted?)")
            return
        self.buf += data
        while b"\n" in self.buf:
            line, _, self.buf = self.buf.partition(b"\n")
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            kind = ev.get("type")
            if kind == "notif":
                params = ev.get("params", {})
                yield ("diags", params.get("uri"),
                       params.get("diagnostics", []))
            elif kind == "doc":
                uri = ev.get("uri")
                if ev.get("method") == "textDocument/didClose":
                    self.docs.pop(uri, None)
                    yield ("closed", uri)
                else:
                    self.docs[uri] = ev.get("version")
                    yield ("changed", uri, ev.get("pos"))
            elif kind == "response":
                yield ("response", ev.get("id"),
                       ev.get("result", {"logs": ""}))


class LocalBackend:
    """Panel backend that spawns its own `lambdapi lsp` and syncs the
    tracked file from disk (fallback when no bridge is running)."""

    def __init__(self, root_uri):
        self.proc = subprocess.Popen(
            find_lambdapi_cmd(), stdin=subprocess.PIPE,
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        os.set_blocking(self.proc.stdout.fileno(), False)
        self.msgbuf = MsgBuffer()
        self.next_id = 0
        self.versions = {}         # uri -> version
        self._initialize(root_uri)

    def _write(self, msg):
        try:
            self.proc.stdin.write(lsp_frame(msg))
            self.proc.stdin.flush()
        except (BrokenPipeError, OSError):
            pass

    def _request(self, method, params):
        self.next_id += 1
        self._write({"jsonrpc": "2.0", "id": self.next_id,
                     "method": method, "params": params})
        return self.next_id

    def _notify(self, method, params):
        self._write({"jsonrpc": "2.0", "method": method, "params": params})

    def _initialize(self, root_uri):
        mid = self._request("initialize", {
            "processId": os.getpid(), "rootUri": root_uri,
            "capabilities": {}})
        deadline = time.time() + 15
        while time.time() < deadline:
            ready, _, _ = select.select([self.proc.stdout], [], [], 0.2)
            if not ready:
                continue
            try:
                data = self.proc.stdout.read()
            except BlockingIOError:
                continue
            if data:
                self.msgbuf.feed(data)
            for msg in self.msgbuf.messages():
                if msg.get("id") == mid:
                    self._notify("initialized", {})
                    return
        sys.exit("lp-goals: lambdapi lsp did not answer initialize")

    def fds(self):
        return [self.proc.stdout]

    def close(self):
        try:
            self._request("shutdown", {})
            self._notify("exit", {})
            self.proc.stdin.close()
            self.proc.wait(timeout=2)
        except (OSError, subprocess.TimeoutExpired):
            self.proc.kill()

    def alive(self):
        return self.proc.poll() is None

    def is_open(self, uri):
        return True                # we open documents ourselves

    def sync_file(self, uri, text):
        if uri in self.versions:
            self.versions[uri] += 1
            self._notify("textDocument/didChange", {
                "textDocument": {"uri": uri,
                                 "version": self.versions[uri]},
                "contentChanges": [{"text": text}]})
        else:
            self.versions[uri] = 1
            self._notify("textDocument/didOpen", {
                "textDocument": {"uri": uri, "languageId": "lambdapi",
                                 "version": 1, "text": text}})

    def close_file(self, uri):
        if uri in self.versions:
            del self.versions[uri]
            self._notify("textDocument/didClose",
                         {"textDocument": {"uri": uri}})

    def request_goals(self, uri, line0, col0):
        return self._request("proof/goals", {
            "textDocument": {"uri": uri},
            "position": {"line": line0, "character": col0}})

    def drain(self):
        if not self.alive():
            yield ("down", "lambdapi lsp exited")
            return
        try:
            data = self.proc.stdout.read()
            if data:
                self.msgbuf.feed(data)
        except (BlockingIOError, ValueError):
            pass
        for msg in self.msgbuf.messages():
            if msg.get("method") == "textDocument/publishDiagnostics":
                params = msg.get("params", {})
                yield ("diags", params.get("uri"),
                       params.get("diagnostics", []))
            elif "id" in msg and ("result" in msg or "error" in msg):
                yield ("response", msg["id"],
                       msg.get("result", {"logs": ""}))


# --- goal formatting ----------------------------------------------------

# Server-provided text is rendered straight into a terminal: strip
# escape sequences and control characters (keeping \n and \t) so a
# hostile diagnostic or goal cannot inject cursor movement or worse.
_CONTROL = re.compile(
    r"\x1b\[[0-9;?]*[ -/]*[@-~]"       # CSI sequences
    r"|\x1b."                          # other ESC sequences
    r"|[\x00-\x08\x0b-\x1f\x7f]")      # C0 controls except \t and \n


def sanitize(text):
    return _CONTROL.sub("", str(text))


def format_goals(result, show_logs=False, clamped=False):
    """Render a proof/goals result. Returns a list of lines."""
    lines = []
    goals = result.get("goals")
    if goals is None:
        lines.append(f"{DIM}Not inside a proof.{RESET}")
    elif not goals:
        if clamped:
            lines.append(f"{DIM}No goal information at the error point.{RESET}")
        else:
            lines.append(f"{GREEN}✓ No goals remaining.{RESET}")
    else:
        n = len(goals)
        for i, goal in enumerate(goals):
            kind = goal.get("typeofgoal", "?")
            hyps = goal.get("hyps", [])
            if kind == "Typ":
                gid = sanitize(goal.get("gid", "?"))
                head = (f"{BOLD}{CYAN}Goal {i + 1} of {n}{RESET} "
                        f"{DIM}({gid}){RESET}")
            else:
                head = f"{BOLD}{MAGENTA}Unification goal {i + 1} of {n}{RESET}"
            lines.append(head)
            if hyps:
                names = [sanitize(h.get("hname", "?")) for h in hyps]
                width = max(len(name) for name in names)
                for name, h in zip(names, hyps):
                    # htype carries its own separator: ": ty" or "≔ def"
                    htype = sanitize(h.get("htype", "")).strip()
                    lines.append(f"  {GREEN}{name:<{width}}{RESET} {htype}")
            lines.append(rule())
            body = goal.get("type") if kind == "Typ" else goal.get("constr")
            lines.append(f"  {BOLD}⊢ {sanitize(body)}{RESET}")
            if i < n - 1:
                lines.append("")
    logs = result.get("logs", "")
    if show_logs and logs.strip():
        lines.append("")
        lines.append(f"{DIM}── logs {'─' * 20}{RESET}")
        tail = logs.strip().splitlines()[-12:]
        lines.extend(f"{DIM}{sanitize(ln)}{RESET}" for ln in tail)
    return lines


def format_diagnostics(diags, limit=6):
    """Render diagnostics (errors and warnings only)."""
    lines = []
    bad = [d for d in diags if d.get("severity", 4) <= 2]
    for d in bad[:limit]:
        sev = d.get("severity", 1)
        color = RED if sev == 1 else YELLOW
        pos = d.get("range", {}).get("start", {})
        line = pos.get("line", 0) + 1
        msg = sanitize(" ".join(d.get("message", "").split()))
        if len(msg) > 400:
            msg = msg[:400] + "…"
        lines.append(f"{color}✗ L{line}:{RESET} {msg}")
    if len(bad) > limit:
        lines.append(f"{DIM}… and {len(bad) - limit} more{RESET}")
    return lines


# --- the panel (serve mode) ----------------------------------------------

class Panel:
    def __init__(self, sock_path, initial_file=None, show_logs=False,
                 standalone=False):
        self.sock_path = sock_path
        self.show_logs = show_logs
        self.standalone = standalone
        self.backend = None
        self.bridged = False
        self.server = None        # 'at' ping listener
        self.file = None          # absolute path of tracked file
        self.uri = None
        self.mtime = 0.0          # local mode only
        self.pos = None           # (line, col) 1-based, last requested
        self.goals = None         # last proof/goals result
        self.diags = []           # last diagnostics for tracked uri
        self.checked = False      # check completed since last change
        self.changed_at = 0.0
        self.pending = None       # in-flight goals request id
        self.stale = False
        self.status = "starting"
        self.retry_at = 0.0       # next bridge reconnect attempt
        self.follow = True        # track the typing point (bridge mode)
        self.termios_saved = None
        self.initial_file = (os.path.abspath(initial_file)
                             if initial_file else None)

    # -- 'at' ping socket -------------------------------------------

    def bind_socket(self):
        if self.sock_path is None:
            sys.exit("lp-goals: no private runtime directory for the "
                     "panel socket (set LP_GOALS_SOCKET to override)")
        if os.path.exists(self.sock_path):
            probe = socket.socket(socket.AF_UNIX)
            try:
                probe.connect(self.sock_path)
                sys.exit(f"lp-goals: another panel is already running "
                         f"({self.sock_path})")
            except (ConnectionRefusedError, FileNotFoundError):
                try:
                    os.unlink(self.sock_path)   # stale socket
                except OSError:
                    pass
            except OSError:
                pass            # unknown state; let bind() decide below
            finally:
                probe.close()
        self.server = socket.socket(socket.AF_UNIX)
        try:
            self.server.bind(self.sock_path)
        except OSError as e:
            if e.errno == errno.EADDRINUSE:
                sys.exit(f"lp-goals: another panel is already running "
                         f"({self.sock_path})")
            raise
        os.chmod(self.sock_path, 0o600)
        self.server.listen(8)

    # -- backend management ------------------------------------------

    def attach(self):
        """Connect to a bridge if possible, else spawn our own LSP."""
        if not self.standalone:
            backend = BridgeBackend.discover(self.file or self.initial_file)
            if backend:
                self.backend = backend
                self.bridged = True
                self.status = "attached to Zed's LSP"
                return
        if self.standalone:
            root = find_root(self.file or self.initial_file or os.getcwd())
            self.backend = LocalBackend(file_uri(root))
            self.bridged = False
            self.status = "standalone LSP session"
            return
        self.backend = None
        self.status = ("waiting for Zed's Lambdapi LSP "
                       "(open a .lp file; or use --standalone)…")

    def backend_down(self, reason):
        if self.backend:
            self.backend.close()
        self.backend = None
        self.pending = None
        self.checked = False
        self.status = f"{reason} — reconnecting"
        self.retry_at = time.time() + 1.0
        self.render()

    # -- document tracking --------------------------------------------

    def canonical_uri(self, path_or_uri):
        """Resolve a path or uri to the exact uri string the server
        knows. In bridge mode that is Zed's open-document uri (whose
        percent-encoding we must reproduce verbatim, else diagnostics
        matching and proof/goals lookups miss); fall back to file_uri."""
        if path_or_uri.startswith("file://"):
            want = os.path.abspath(uri_to_path(path_or_uri))
        else:
            want = os.path.abspath(path_or_uri)
        if self.bridged and self.backend:
            for u in self.backend.docs:
                if os.path.abspath(uri_to_path(u)) == want:
                    return u
        return file_uri(want)

    def track(self, path):
        path = os.path.abspath(path)
        if path == self.file:
            return
        old_uri = self.uri
        self.file = path
        self.uri = self.canonical_uri(path)
        self.goals = None
        self.diags = []
        self.stale = True
        self.pending = None
        if self.bridged and self.backend:
            # Zed owns the document; we only read. Seed diagnostics
            # from the bridge's cache when available.
            cached = self.backend.initial_diags.get(self.uri)
            if cached:
                self.diags = cached.get("diagnostics", [])
            self.checked = self.backend.is_open(self.uri)
        elif self.backend:
            if old_uri:
                self.backend.close_file(old_uri)
            try:
                text = open(path, encoding="utf-8",
                            errors="replace").read()
                self.mtime = os.path.getmtime(path)
            except OSError as e:
                self.status = f"cannot read {path}: {e}"
                return
            self.backend.sync_file(self.uri, text)
            self.checked = False
            self.changed_at = time.time()
            self.status = "checking…"

    def reload_local(self):
        try:
            text = open(self.file, encoding="utf-8",
                        errors="replace").read()
        except OSError:
            return
        self.backend.sync_file(self.uri, text)
        self.checked = False
        self.changed_at = time.time()
        self.stale = True
        self.status = "checking…"
        self.render()

    # -- event handling ------------------------------------------------

    def handle_event(self, ev):
        kind = ev[0]
        if kind == "down":
            self.backend_down(ev[1])
        elif kind == "diags":
            _, uri, diags = ev
            if uri == self.uri:
                self.diags = diags
                self.checked = True
                self.stale = True
                n = len([d for d in diags if d.get("severity") == 1])
                self.status = (f"{n} error{'s' if n > 1 else ''}" if n
                               else "checked")
                self.render()
        elif kind == "changed":
            _, uri, pos = ev
            # Follow mode: jump to where the user is typing, switching
            # files if the edit happened in another open .lp buffer.
            if (self.follow and pos and uri.endswith(".lp")
                    and uri.startswith("file://")):
                self.track(uri_to_path(uri))
                self.pos = (pos["line"] + 1, pos["character"] + 1)
                self.stale = True
            if uri == self.uri:
                self.checked = False
                self.changed_at = time.time()
                self.stale = True
                self.status = "checking…"
                self.render()
        elif kind == "closed":
            _, uri = ev
            if uri == self.uri:
                self.status = "file closed in Zed"
                self.render()
        elif kind == "response":
            _, rid, result = ev
            if rid == self.pending:
                self.pending = None
                self.goals = result
                self.render()

    def handle_client(self, data):
        try:
            req = json.loads(data)
        except ValueError:
            return
        path = req.get("file")
        line = req.get("line")
        col = req.get("col", 1)
        if not path or not isinstance(line, int):
            return
        if not path.endswith(".lp"):
            return
        self.track(path)
        self.pos = (line, max(1, col if isinstance(col, int) else 1))
        self.stale = True
        self.render()

    def maybe_request_goals(self):
        if not (self.backend and self.stale and self.pos and self.uri):
            return
        if self.bridged and not self.backend.is_open(self.uri):
            self.status = "file not open in Zed"
            return
        # Wait for the check to finish so the server's document table
        # has this uri; fall back after 10s in case no diagnostics
        # notification ever arrives.
        if not self.checked and time.time() - self.changed_at < 10:
            return
        if self.pending is not None:
            return
        line, col = self.pos
        self.pending = self.backend.request_goals(self.uri, line - 1, col - 1)
        self.stale = False

    # -- rendering -------------------------------------------------------

    def first_error_before_pos(self):
        """1-based line of the first error, if it precedes the last
        requested position (the server clamps goals to it)."""
        if not self.pos:
            return None
        err_lines = [d["range"]["start"]["line"] + 1 for d in self.diags
                     if d.get("severity") == 1 and "range" in d]
        if not err_lines:
            return None
        first = min(err_lines)
        return first if first <= self.pos[0] else None

    def render(self):
        out = ["\033[2J\033[H"] if _want_color() else []
        name = os.path.basename(self.file) if self.file else "no file"
        pos = f":{self.pos[0]}:{self.pos[1]}" if self.pos else ""
        if self.backend is None:
            mode = "detached"
        elif self.bridged:
            mode = "⇄ zed · " + ("follow" if self.follow else "pinned")
        else:
            mode = "standalone"
        clock = time.strftime("%H:%M:%S")
        out.append(f"{BOLD}λΠ {name}{pos}{RESET}  "
                   f"{DIM}{self.status} · {mode} · {clock}{RESET}")
        out.append(rule("═"))
        if self.goals is not None:
            clamp = self.first_error_before_pos()
            out.extend(format_goals(self.goals, self.show_logs,
                                    clamped=clamp is not None))
            if clamp is not None:
                out.append(f"{DIM}(goals shown at the first error, "
                           f"line {clamp}){RESET}")
        elif self.pos is None:
            hint = ("type in a .lp buffer, or run the "
                    "“Lambdapi: Goals at Cursor” task"
                    if self.bridged and self.follow else
                    "run the “Lambdapi: Goals at Cursor” task in Zed")
            out.append(f"{DIM}Waiting for a position — {hint}.{RESET}")
        else:
            out.append(f"{DIM}…{RESET}")
        if self.diags:
            errlines = format_diagnostics(self.diags)
            if errlines:
                out.append("")
                out.append(rule())
                out.extend(errlines)
        if self.termios_saved is not None:
            out.append("")
            out.append(f"{DIM}f follow · l logs · q quit{RESET}")
        print("\n".join(out), flush=True)

    # -- main loop ---------------------------------------------------------

    def setup_keys(self):
        """Single-key controls when running in a real terminal."""
        if not sys.stdin.isatty():
            return
        try:                       # Unix-only; imported lazily so the
            import termios         # other modes never depend on them
            import tty
        except ImportError:
            return
        try:
            self.termios_saved = termios.tcgetattr(sys.stdin.fileno())
            tty.setcbreak(sys.stdin.fileno())
        except termios.error:
            self.termios_saved = None

    def restore_keys(self):
        if self.termios_saved is None:
            return
        try:
            import termios
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN,
                              self.termios_saved)
        except Exception:
            pass

    def teardown(self):
        try:
            os.unlink(self.sock_path)
        except OSError:
            pass
        if self.backend:
            self.backend.close()
            self.backend = None
        self.restore_keys()

    def run(self):
        self.bind_socket()
        self.attach()
        self.setup_keys()
        if self.initial_file:
            self.track(self.initial_file)
            self.pos = None
        self.render()

        def on_signal(*_):
            raise KeyboardInterrupt

        signal.signal(signal.SIGINT, on_signal)
        signal.signal(signal.SIGTERM, on_signal)
        signal.signal(signal.SIGHUP, on_signal)

        try:
            self.loop()
        except KeyboardInterrupt:
            pass
        finally:
            self.teardown()
            print(f"\n{DIM}lp-goals stopped.{RESET}")

    def loop(self):
        last_poll = 0.0
        while True:
            if self.backend is None and time.time() >= self.retry_at:
                self.attach()
                if self.backend:
                    file = self.file
                    self.file = None    # force re-track
                    if file:
                        self.track(file)
                    self.render()
                else:
                    self.retry_at = time.time() + 1.0

            fds = [self.server]
            if self.backend:
                fds.extend(self.backend.fds())
            if self.termios_saved is not None:
                fds.append(sys.stdin)
            ready, _, _ = select.select(fds, [], [], 0.25)

            if sys.stdin in ready:
                key = sys.stdin.read(1)
                if key in ("q", "\x03"):
                    raise KeyboardInterrupt
                elif key == "f":
                    self.follow = not self.follow
                    self.render()
                elif key == "l":
                    self.show_logs = not self.show_logs
                    self.render()

            if self.backend and any(f in ready for f in self.backend.fds()):
                for ev in list(self.backend.drain()):
                    self.handle_event(ev)

            if self.server in ready:
                conn, _ = self.server.accept()
                conn.settimeout(1.0)
                try:
                    data = conn.recv(65536)
                    if data:
                        self.handle_client(data.decode(errors="replace"))
                except OSError:
                    pass
                finally:
                    conn.close()

            # Local mode syncs the file from disk.
            now = time.time()
            if (self.backend and not self.bridged and self.file
                    and now - last_poll > 0.3):
                last_poll = now
                try:
                    mtime = os.path.getmtime(self.file)
                    if mtime != self.mtime:
                        self.mtime = mtime
                        self.reload_local()
                except OSError:
                    pass

            self.maybe_request_goals()


# --- client + one-shot modes ----------------------------------------------

def send_position(sock_path, path, line, col):
    if sock_path is None:
        sys.exit("lp-goals: no goals panel running — start the "
                 "“Lambdapi: Goals Panel” task in Zed first.")
    msg = json.dumps({"file": os.path.abspath(path),
                      "line": line, "col": col})
    client = socket.socket(socket.AF_UNIX)
    try:
        client.connect(sock_path)
        client.sendall(msg.encode())
    except (ConnectionRefusedError, FileNotFoundError):
        sys.exit("lp-goals: no goals panel running — start the "
                 "“Lambdapi: Goals Panel” task in Zed first.")
    finally:
        client.close()


def run_once(path, line, col, show_logs=False):
    path = os.path.abspath(path)
    uri = file_uri(path)
    backend = LocalBackend(file_uri(find_root(path)))
    try:
        backend.sync_file(uri, open(path, encoding="utf-8",
                                    errors="replace").read())
        diags, checked = [], False
        deadline = time.time() + 60
        while time.time() < deadline and not checked:
            select.select(backend.fds(), [], [], 0.5)
            for ev in backend.drain():
                if ev[0] == "diags" and ev[1] == uri:
                    diags = ev[2]
                    checked = True
                elif ev[0] == "down":
                    sys.exit("lp-goals: lambdapi lsp exited")
        if not checked:
            sys.exit("lp-goals: timed out waiting for lambdapi to check "
                     + path)
        mid = backend.request_goals(uri, line - 1, col - 1)
        deadline = time.time() + 15
        while time.time() < deadline:
            select.select(backend.fds(), [], [], 0.5)
            for ev in backend.drain():
                if ev[0] == "response" and ev[1] == mid:
                    print("\n".join(format_goals(ev[2], show_logs)))
                    errs = format_diagnostics(diags)
                    if errs:
                        print()
                        print("\n".join(errs))
                    return
        sys.exit("lp-goals: timed out waiting for goals")
    finally:
        backend.close()


# --- entry point ------------------------------------------------------------

def parse_pos(args, what):
    if not args:
        sys.exit(f"lp-goals: {what} requires FILE LINE [COL]")
    try:
        line = int(args[0])
        col = int(args[1]) if len(args) > 1 else 1
    except ValueError:
        sys.exit("lp-goals: LINE and COL must be integers (1-based)")
    return line, col


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        sys.exit(0)

    if argv[0] == "bridge":
        rest = argv[1:]
        if rest and rest[0] == "--":
            rest = rest[1:]
        if not rest:
            sys.exit("lp-goals: bridge requires the server command, "
                     "e.g. lp-goals bridge -- lambdapi lsp")
        Bridge(rest).run()
        return

    show_logs = "--logs" in argv
    standalone = "--standalone" in argv
    args = [a for a in argv if a not in ("--logs", "--standalone")]
    cmd, rest = args[0], args[1:]
    sock = panel_socket_path()

    if cmd == "serve":
        Panel(sock, rest[0] if rest else None, show_logs,
              standalone=standalone).run()
    elif cmd == "at":
        if not rest:
            sys.exit("lp-goals: at requires FILE LINE [COL]")
        line, col = parse_pos(rest[1:], "at")
        send_position(sock, rest[0], line, col)
    elif cmd == "once":
        if not rest:
            sys.exit("lp-goals: once requires FILE LINE [COL]")
        line, col = parse_pos(rest[1:], "once")
        run_once(rest[0], line, col, show_logs)
    else:
        print(__doc__.strip())
        sys.exit(f"\nlp-goals: unknown command {cmd!r}")


if __name__ == "__main__":
    main()
